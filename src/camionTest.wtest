import camion.*
import cosas.*
describe "carga, descarga y peso" {

    method initialize() {
        camion.cargar(bumblebee)
    }
    test "se carga un objeto en el camion" {
        assert.equals([bumblebee], camion.carga())
    }

    test "se cargan objetos, se supera el limite de peso y falla" {
        assert.throwsException({camion.cargar(bumblebee)})
        assert.equals(1800, camion.pesoTotal())
    }


    test "se descarga un objeto existente en el camion" {
        camion.descargar(bumblebee)
        assert.equals([], camion.carga())
    }

    test "se ordena descargar un objeto que no esta en el camion y da el fallo correspondiente" {
        assert.throwsException({camion.descargar(knightRider)})
    }

    test "un camion que lleva un bumblebee pesa 1800kg en total" {
        assert.equals(1800, camion.pesoTotal())
    }

    test "se carga el camion con 800kg y no se marca como excedido de peso" {
         assert.notThat(camion.excedidoDePeso())
    }

    

}

describe "niveles de peligrosidad" {

method initialize() {
    camion.cargar(bateriaAntiaerea) //0
    camion.cargar(bumblebee)//15
    camion.cargar(residuosRadioactivos)//200
}
    test "se devuelven los objetos mas peligrosos que lo indicado" {
        assert.equals([residuosRadioactivos], camion.objetosPeligrosos(100))
    }

    test "se devuelven los objetos mas peligrosos que el elegido del mismo camion" {
        assert.equals([bateriaAntiaerea, residuosRadioactivos], camion.objetosMasPeligrososQue(bumblebee))
    }

    test "el camion no puede circular en ruta porque no todos sus elementos son tan seguros" {
        assert.notThat(camion.puedeCircularEnRuta(10))
    }
}

describe "ladrllos, peligrosidad y peso" {
    method initialize() {
        paqueteDeLadrillos.agregarLadrillos(950)
    }

    test "el peso del paquete es de 2000kg y su peligrosidad es de 40" {
        assert.equals(2000, paqueteDeLadrillos.peso())
        assert.equals(40, paqueteDeLadrillos.nivelPeligrosidad())
    }

    test "se agregan 70 larillos y el peso del paquete aumenta a 2250kg y su peligrosidad a 29" {
        paqueteDeLadrillos.agregarLadrillos(70)
        assert.equals(2250, paqueteDeLadrillos.peso())
        assert.equals(29, paqueteDeLadrillos.nivelPeligrosidad())
    }



}

describe "contenedor portuario, peligrosidad y peso" {
    method initialize() {
        contenedorPortuario.guardarAlgo(knightRider)
        contenedorPortuario.guardarAlgo(bumblebee)
    }

    test "el peso total del contenedor es de 1400kg y su peligrosidad es 15" {
        assert.equals(1400, contenedorPortuario.peso())
        assert.equals(15, contenedorPortuario.nivelPeligrosidad())
    }

}


describe "agregando cosas al camion tests" {
method initialize() {
    camion.cargar(bateriaAntiaerea) //300
    camion.cargar(bumblebee)//800
    camion.cargar(residuosRadioactivos)//35
}
test "se devuelve la lista de pesos, en este caso con un 800" {
        assert.equals([300, 800, 35], camion.pesos())
    }

    test "se devuelve a bumblebee por ser la cosa mas pesada del camion" {
        assert.equals(bumblebee, camion.cosaMasPesada())
    }

    test "en total se suman 5 bultos en el camion" {
        assert.equals(5, camion.totalBultos())
    }

    test "indica true al preguntar si hay un elemento que pesa entre 20kg y 100kg" {
        assert.that(camion.tieneAlgoQuePesaEntre(15, 100))
    }

    
}

describe "modificaciones al cargar las cosas" {
    test "se carga una bateriaAntiaerea al camion y se carga con misiles, aumentando peligrosidad y peso" {
        assert.equals(200, bateriaAntiaerea.peso())
        assert.equals(0, bateriaAntiaerea.nivelPeligrosidad())
        camion.cargar(bateriaAntiaerea)
        assert.equals(300, bateriaAntiaerea.peso())
        assert.equals(100, bateriaAntiaerea.nivelPeligrosidad())
    }
}